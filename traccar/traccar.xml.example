<?xml version='1.0' encoding='UTF-8'?>

<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>

<properties>

    <!-- Database -->
    <!-- Default: embedded H2. Pre PostgreSQL pozri https://www.traccar.org/configuration-file/ -->
    <entry key="database.driver">org.h2.Driver</entry>
    <entry key="database.url">jdbc:h2:./data/database</entry>
    <entry key="database.user">sa</entry>
    <entry key="database.password"></entry>

    <!-- Web Server -->
    <entry key="web.port">8082</entry>
    <entry key="web.forwarded">true</entry>

    <!-- OsmAnd / Traccar Client protocol -->
    <entry key="osmand.port">5055</entry>

    <!-- Disable all other protocols (not needed for phone tracking) -->
    <entry key="gps103.port">0</entry>
    <entry key="tk103.port">0</entry>
    <entry key="gl100.port">0</entry>
    <entry key="gl200.port">0</entry>
    <entry key="t55.port">0</entry>
    <entry key="xexun.port">0</entry>
    <entry key="totem.port">0</entry>
    <entry key="enfora.port">0</entry>
    <entry key="meiligao.port">0</entry>
    <entry key="trv.port">0</entry>
    <entry key="suntech.port">0</entry>
    <entry key="progress.port">0</entry>
    <entry key="h02.port">0</entry>
    <entry key="jt600.port">0</entry>
    <entry key="huabao.port">0</entry>
    <entry key="v680.port">0</entry>
    <entry key="pt502.port">0</entry>
    <entry key="tr20.port">0</entry>
    <entry key="navis.port">0</entry>
    <entry key="meitrack.port">0</entry>
    <entry key="skypatrol.port">0</entry>
    <entry key="gt02.port">0</entry>
    <entry key="gt06.port">0</entry>
    <entry key="megastek.port">0</entry>
    <entry key="navigil.port">0</entry>
    <entry key="gpsgate.port">0</entry>
    <entry key="teltonika.port">0</entry>
    <entry key="mta6.port">0</entry>
    <entry key="tzone.port">0</entry>
    <entry key="tlt2h.port">0</entry>
    <entry key="taip.port">0</entry>
    <entry key="wondex.port">0</entry>
    <entry key="cellocator.port">0</entry>
    <entry key="galileo.port">0</entry>
    <entry key="ywt.port">0</entry>
    <entry key="compatible.port">0</entry>
    <entry key="appello.port">0</entry>
    <entry key="idpl.port">0</entry>
    <entry key="calamp.port">0</entry>
    <entry key="mtx.port">0</entry>
    <entry key="tytan.port">0</entry>
    <entry key="avl301.port">0</entry>
    <entry key="castel.port">0</entry>
    <entry key="mxt.port">0</entry>
    <entry key="cityeasy.port">0</entry>
    <entry key="aquila.port">0</entry>
    <entry key="flextrack.port">0</entry>
    <entry key="blackkite.port">0</entry>
    <entry key="adm.port">0</entry>
    <entry key="watch.port">0</entry>
    <entry key="t800x.port">0</entry>
    <entry key="upro.port">0</entry>
    <entry key="auro.port">0</entry>
    <entry key="disha.port">0</entry>
    <entry key="thinkrace.port">0</entry>
    <entry key="pathaway.port">0</entry>
    <entry key="arnavi.port">0</entry>
    <entry key="nvs.port">0</entry>
    <entry key="kenji.port">0</entry>
    <entry key="astra.port">0</entry>
    <entry key="homtecs.port">0</entry>
    <entry key="fox.port">0</entry>
    <entry key="gnx.port">0</entry>
    <entry key="arknav.port">0</entry>
    <entry key="supermate.port">0</entry>
    <entry key="appello.port">0</entry>
    <entry key="ais.port">0</entry>

    <!-- Geocoder (Nominatim - free, no API key needed) -->
    <entry key="geocoder.enable">true</entry>
    <entry key="geocoder.type">nominatim</entry>
    <entry key="geocoder.url">https://nominatim.openstreetmap.org/reverse</entry>

    <!-- Position filtering -->
    <entry key="filter.enable">true</entry>
    <entry key="filter.invalid">true</entry>
    <entry key="filter.zero">true</entry>
    <entry key="filter.duplicate">true</entry>
    <entry key="filter.approximate">false</entry>
    <entry key="filter.skipLimit">600</entry>
    <entry key="filter.maxSpeed">300</entry>
    <entry key="filter.minPeriod">5</entry>

    <!-- Trip detection -->
    <entry key="report.trip.minimalTripDistance">500</entry>
    <entry key="report.trip.minimalTripDuration">120</entry>
    <entry key="report.trip.minimalParkingDuration">300</entry>
    <entry key="report.trip.minimalNoDataDuration">600</entry>
    <entry key="report.trip.useIgnition">false</entry>

    <!-- Server settings -->
    <entry key="server.forceSettings">false</entry>

</properties>
