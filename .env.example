# Skopíruj do .env a vyplň. .env NIKDY necommituj.
POSTGRES_PASSWORD=change-me
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me-too
# Traccar účet, cez ktorý kniha jázd číta pozície a jazdy (vytvor ho v Traccar UI)
TRACCAR_EMAIL=admin@example.com
TRACCAR_PASSWORD=change-me
# Google Maps/Routes/Places kľúč, obmedzený na HTTP referrer PUBLIC_URL
GOOGLE_PLACES_API_KEY=
PUBLIC_URL=https://logbook.example.com/
CORS_ORIGIN=https://logbook.example.com
POSITION_RETENTION_DAYS=90
